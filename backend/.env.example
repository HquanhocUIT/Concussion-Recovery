DATABASE_URL=postgresql://reentry:reentry@localhost:5432/reentry
RAG_SERVICE_URL=http://localhost:8100
SECRET_KEY=change-me
# Set ONE provider key so the assistant rewords retrieved evidence into
# plain language. With neither, it quotes guideline sentences verbatim.
# Never commit a real key: this file is tracked.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
